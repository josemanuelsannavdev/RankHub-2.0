# Shared database credentials for the compose stack
DB_USERNAME=postgres
DB_PASSWORD=postgres

# Auth service
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
JWT_SECRET=replace-with-a-32-plus-character-secret
JWT_EXPIRATION_MS=3600000
GOOGLE_REDIRECT_URI=http://localhost:8081/login/oauth2/code/google
FRONTEND_OAUTH_CALLBACK_URL=http://localhost:3000/oauth/callback
FRONTEND_URL=http://localhost:3000

# Invitation service
MAIL_USERNAME=your-mail-user
MAIL_PASSWORD=your-mail-password
RESEND_API_KEY=your-resend-api-key
RESEND_FROM_EMAIL=onboarding@tuapp.com

# Frontend build-time variables
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=